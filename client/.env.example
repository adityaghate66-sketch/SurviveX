# Copy to client/.env for local overrides. Vite only exposes VITE_* variables.

# Local dev proxy target. Leave this as the Express API port.
VITE_API_TARGET=http://localhost:4000

# Production API base URL, INCLUDING /api.
# Leave empty in local dev so requests use the Vite proxy at /api.
# Example: https://survivex-api.onrender.com/api
VITE_API_BASE_URL=
