# Copy this file to .env and fill in real values.
# .env is git-ignored; .env.example is committed as documentation.

# Port the Express API listens on.
PORT=4000

# development | production
NODE_ENV=development

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string (used from Stage 3 onwards).
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/survivex_dev?schema=public
