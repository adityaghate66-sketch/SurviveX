# Copy this file to .env and fill in real values.
# .env is git-ignored; .env.example is committed as documentation.

# Port the Express API listens on.
PORT=4000

# development | production
NODE_ENV=development

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string used by the running API.
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/survivex_dev?schema=public

# Prisma CLI (migrate/generate/studio) reads this instead of DATABASE_URL.
DIRECT_URL=postgresql://postgres:your_password_here@localhost:5432/survivex_dev?schema=public

# Auth: generate a long random value for production (e.g. openssl rand -hex 32).
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
